# Development browser origin; must match the address you open exactly.
APP_ORIGIN=http://localhost:5173
PORT=3001
DATABASE_PATH=.data/chatlas.sqlite
# Optional for Demo. Configure through secure environment settings or local .env.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Run npm run secrets:init to populate these locally. Do not commit .env.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
MODEL_CACHE_DIR=.model-cache
